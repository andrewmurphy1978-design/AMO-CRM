# Postgres connection string
DATABASE_URL="postgresql://amo_crm:amo_crm@localhost:5432/amo_crm?schema=public"

# NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Used to encrypt the systeme.io API key before storing it in the database.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-a-random-32-byte-secret"

# Optional: protects /api/cron/systeme-io-sync when you wire up a scheduled
# trigger (e.g. Vercel Cron) to keep contacts synced automatically.
CRON_SECRET="replace-with-a-random-secret"

# Optional: seed script creates the first admin user with these credentials
SEED_ADMIN_EMAIL="andrewmurphy1978@gmail.com"
SEED_ADMIN_PASSWORD="change-me-after-first-login"
SEED_ADMIN_NAME="Andrew Murphy"
