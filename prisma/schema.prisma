// Prisma schema for Andrew Murphy Online CRM
// Docs: https://pris.ly/d/prisma-schema

// Prisma runs over a driver instance we construct in code (node-postgres
// locally, the same driver pointed at Cloudflare's Hyperdrive binding in
// production) instead of connecting from a URL itself — required because
// Cloudflare Workers can't open its own raw database connections. See
// src/lib/prisma.ts.
// engineType "client" is Prisma's engine-less, pure-JS/WASM query compiler
// — the only engine type compatible with the `adapter` option (see
// src/lib/prisma.ts), which is what lets this run without a native binary
// on Cloudflare Workers.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
}

enum Language {
  EN
  FR
}

enum TimeFormat {
  HOUR24
  HOUR12
}

model User {
  id                         String     @id @default(cuid())
  name                       String
  email                      String     @unique
  passwordHash               String
  role                       UserRole   @default(MEMBER)
  phone                      String?
  whatsapp                   String?
  country                    String     @default("CA")
  language                   Language   @default(EN)
  timeFormat                 TimeFormat @default(HOUR24)
  // Free-text rules appended to the Email page's Claude classification
  // prompt for this user's own inbox — e.g. "always treat emails from
  // my accountant as Needs a reply". Never required; screening works
  // fine with the built-in categories alone when this is empty.
  emailScreeningInstructions String?    @db.Text
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  ownedProjects   Project[]          @relation("ProjectOwner")
  ownedContacts   Contact[]          @relation("ContactOwner")
  assignedTasks   Task[]             @relation("TaskAssignee")
  activityEntries ActivityLogEntry[]
  interactions    Interaction[]
  googleAccount   GoogleAccount?

  @@map("users")
}

// One personal Google connection per CRM user (Gmail + Calendar,
// read-only) — unlike IntegrationSetting below, this is never shared
// across the team, so it's its own model keyed to User rather than a
// provider-keyed singleton row.
model GoogleAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String?
  tokensEncrypted String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("google_accounts")
}

// ---------------------------------------------------------------------------
// Contacts / Clients (System.IO contact model)
// ---------------------------------------------------------------------------

// Lifecycle stage within our own pipeline (separate from systeme.io tags,
// which are synced verbatim into ContactTag below).
enum ContactStage {
  LEAD
  PROSPECT
  CLIENT
  PAST_CLIENT
  UNSUBSCRIBED
}

model Contact {
  id String @id @default(cuid())

  // --- Core systeme.io fields ---
  // systeme.io's own numeric contact id, used as the sync key. Null for
  // contacts created directly in the CRM that have not been pushed/matched
  // to systeme.io yet.
  systemeIoId           Int?      @unique
  email                 String    @unique
  locale                String? // e.g. "en", "fr"
  systemeIoRegisteredAt DateTime? // registered_at from systeme.io

  // --- Common systeme.io custom fields promoted to real columns for
  // fast search/sort. Any other custom field systeme.io returns is stored
  // in ContactFieldValue below so nothing is ever dropped. ---
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  company   String?
  website   String?

  // --- Our own CRM-level fields (not from systeme.io) ---
  // Only the core fields above (phone/address/city/state/zip/country) are
  // pushed back to systeme.io on save — everything below is CRM-only
  // enrichment with no systeme.io equivalent.
  phone2   String?
  whatsapp String?

  otherAddress String?
  otherCity    String?
  otherState   String?
  otherZip     String?
  otherCountry String?

  billingAddress     String?
  billingCity        String?
  billingState       String?
  billingZip         String?
  billingCountry     String?
  billingContactName String?
  billingEmail       String?
  billingPhone       String?

  stage   ContactStage @default(LEAD)
  notes   String?      @db.Text
  ownerId String?
  owner   User?        @relation("ContactOwner", fields: [ownerId], references: [id])

  source       String? // e.g. "systeme.io", "manual", "clickfunnels"
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags                 ContactTag[]
  fieldValues          ContactFieldValue[]
  projects             Project[]
  activity             ActivityLogEntry[]
  interactions         Interaction[]
  subscriptions        Subscription[]
  courseEnrollments    CourseEnrollment[]
  communityMemberships CommunityMembership[]
  emailLinks           EmailLink[]
  calendarEventLinks   CalendarEventLink[]
  bookings             Booking[]

  @@index([stage])
  @@index([lastName, firstName])
  @@map("contacts")
}

// --- Additional systeme.io data (subscriptions, courses, communities) ------
// systeme.io's public API doesn't document exact response field names for
// these resource categories the way it does for Contacts/Tags, so each
// record keeps the full raw payload (`raw`) alongside a few defensively
// extracted common fields — if the extracted fields turn out wrong for this
// account's actual data, the raw JSON is still there to fix them from.

model Subscription {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  status     String?
  planName   String?
  amount     Float?
  currency   String?
  startedAt  DateTime?
  canceledAt DateTime?
  raw        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("subscriptions")
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  courseName String?
  status     String?
  enrolledAt DateTime?
  raw        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("course_enrollments")
}

model CommunityMembership {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  communityName String?
  status        String?
  joinedAt      DateTime?
  raw           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("community_memberships")
}

// Account-level marketing data from systeme.io — not tied to a single
// contact, so these live on their own "Marketing" page rather than the
// Contact detail page (unlike Subscription/CourseEnrollment/
// CommunityMembership above, which are per-contact).
model EmailCampaign {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique

  name           String?
  subject        String?
  status         String?
  sentAt         DateTime?
  recipientCount Int?
  openCount      Int?
  clickCount     Int?
  raw            Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_campaigns")
}

model AutomationWorkflow {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique

  name        String?
  status      String?
  triggerType String?
  raw         Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_workflows")
}

// systeme.io Booking Calendar bookings. The API's Booking resource carries
// only a bare contactName string for one-to-one bookings (never an id, and
// nothing at all for group bookings) — contactId below is filled in by the
// sync as a best-effort match against existing contacts by full name, not
// something systeme.io itself provides, so it's null whenever that match
// is missing or ambiguous (multiple contacts sharing the same name).
model Booking {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique

  eventName       String?
  eventType       String?
  eventDuration   Int?
  maxParticipants Int?
  bookedSlots     Int?
  contactName     String?
  status          String?
  paymentStatus   String?
  scheduledFor    DateTime?
  bookedAt        DateTime?
  raw             Json

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEventLinks CalendarEventLink[]

  @@index([contactId])
  @@map("bookings")
}

// Tag definitions, mirroring systeme.io tags (each has a systeme.io id/name).
model Tag {
  id          String  @id @default(cuid())
  systemeIoId Int?    @unique
  name        String  @unique
  color       String? // for UI badges

  contacts ContactTag[]

  createdAt DateTime @default(now())

  @@map("tags")
}

// Explicit join table (rather than an implicit m2m) so we can record when
// a tag was applied.
model ContactTag {
  contactId String
  tagId     String
  appliedAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

// Definition of every custom field systeme.io knows about (fetched from
// GET /api/contact_fields), so we can label raw slugs in the UI.
model CustomFieldDefinition {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  type      String? // text, number, date, etc. as reported by systeme.io
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ContactFieldValue[]

  @@map("custom_field_definitions")
}

// Catch-all storage for every systeme.io custom field value on a contact,
// including ones we haven't promoted to a dedicated column. This guarantees
// "all System.IO fields" are preserved even as systeme.io accounts add new
// custom fields over time.
model ContactFieldValue {
  id        String  @id @default(cuid())
  contactId String
  fieldSlug String
  value     String? @db.Text

  contact    Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition? @relation(fields: [fieldSlug], references: [slug])

  updatedAt DateTime @updatedAt

  @@unique([contactId, fieldSlug])
  @@map("contact_field_values")
}

// ---------------------------------------------------------------------------
// Projects & Tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  startDate DateTime?
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks              Task[]
  activity           ActivityLogEntry[]
  interactions       Interaction[]
  proposals          Proposal[]
  invoices           Invoice[]
  emailLinks         EmailLink[]
  calendarEventLinks CalendarEventLink[]

  @@index([status])
  @@index([contactId])
  @@map("projects")
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

// Client-facing proposals. Always tied to a Project (which is itself tied to
// a Contact), so a proposal shows up both under its project and — via the
// project's contact — on that contact's page. No separate contactId: the
// project is the single source of truth for who it's for.
model Proposal {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    ProposalStatus @default(DRAFT)
  amount    Float?
  currency  String         @default("CAD")
  notes     String?        @db.Text

  sentAt      DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("proposals")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
}

// Client-facing invoices. Same "always via a Project" shape as Proposal.
model Invoice {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    String?
  status    InvoiceStatus @default(DRAFT)
  amount    Float
  currency  String        @default("CAD")
  notes     String?       @db.Text

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@map("invoices")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailLinks         EmailLink[]
  calendarEventLinks CalendarEventLink[]

  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

// Lightweight activity trail shown on contact/project detail pages.
model ActivityLogEntry {
  id      String @id @default(cuid())
  message String

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([projectId])
  @@map("activity_log_entries")
}

// Ties a Gmail thread to a client/project/task in this CRM. Gmail itself
// stays the source of truth for the message content — this is just a
// pointer keyed off the thread id (one CRM link per thread), so the Email
// page can show "linked to X" and the client/project/task page can show
// its related emails.
model EmailLink {
  id            String @id @default(cuid())
  gmailThreadId String @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@map("email_links")
}

enum EmailCategory {
  NEEDS_REPLY
  NEEDS_ATTENTION
  CAN_WAIT
  LOW_PRIORITY
}

// A message's importance rarely changes once received, so this is a
// permanent cache keyed by Gmail's own message id — classified once (via
// Claude), never reclassified, so revisiting the Email page doesn't
// re-spend an API call on messages it's already seen.
model EmailClassification {
  id             String        @id @default(cuid())
  gmailMessageId String        @unique
  category       EmailCategory
  classifiedAt   DateTime      @default(now())

  @@map("email_classifications")
}

// Marks a message as opened in the CRM (independent of Gmail's own
// read/unread flag — we don't have Gmail write scope, and don't need it;
// this is purely how the Email page decides what to keep showing).
// Once set, the email drops out of its category group into a "Recently
// read" bucket for 7 days (in case it still needs linking), then is
// archived out of view entirely — sooner if it gets linked before that.
model EmailReadState {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  readAt         DateTime @default(now())

  @@map("email_read_states")
}

// The Email page's last-fetched inbox + recent sent-awaiting-reply list,
// one row per user. Reopening the page reads this instead of hitting
// Gmail (and re-spending Claude credits) on every visit — only pressing
// Refresh re-fetches and re-classifies (classification itself stays
// cache-aware via EmailClassification, so a refresh only ever costs a
// Claude call for genuinely new messages).
model EmailInboxCache {
  id                String   @id @default(cuid())
  userId            String   @unique
  emails            Json
  sentAwaitingReply Json?
  fetchedAt         DateTime @default(now())

  @@map("email_inbox_cache")
}

// The roster behind the "Personal" section — a page visible only to
// Andrew, gathering emails and calendar events for family members (and
// himself) rather than the business. Fixed roster (Haley, Lukas, Diane,
// Me), but each one's watched addresses are data, editable from Andrew's
// own Settings card, not code.
model PersonalWatchPerson {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  emails PersonalWatchEmail[]

  @@map("personal_watch_people")
}

model PersonalWatchEmail {
  id       String              @id @default(cuid())
  personId String
  person   PersonalWatchPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  email    String

  @@unique([personId, email])
  @@map("personal_watch_emails")
}

// Same idea as EmailLink, but for a Google Calendar event (keyed off its
// event id) — links an appointment to a client, project, task, and/or a
// systeme.io booking.
model CalendarEventLink {
  id            String @id @default(cuid())
  googleEventId String @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@index([bookingId])
  @@map("calendar_event_links")
}

// A logged call, email, meeting, or note against a client and/or a project —
// distinct from ActivityLogEntry (which is an auto-generated system trail).
// This is user-authored history: "I called this client on this date and
// discussed X." Always tied to a contact; projectId is set when logged from
// a project's page, so the entry shows on both that project and its client.
enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Interaction {
  id      String          @id @default(cuid())
  type    InteractionType
  subject String?
  notes   String          @db.Text

  occurredAt DateTime @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  loggedById String?
  loggedBy   User?   @relation(fields: [loggedById], references: [id])

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([projectId])
  @@map("interactions")
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model IntegrationSetting {
  id              String    @id @default(cuid())
  provider        String    @unique // "systeme_io" | "make"
  apiKeyEncrypted String?
  lastSyncedAt    DateTime?
  lastSyncStatus  String?
  lastSyncError   String?   @db.Text
  autoSyncEnabled Boolean   @default(false)
  autoSyncTime    String    @default("03:00") // "HH:MM", America/Montreal time
  // Provider-specific extra config that doesn't need its own columns/table —
  // e.g. Make's zone + teamId.
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_settings")
}

// A general-purpose encrypted key/value vault — for API keys that don't
// power a specific feature the app calls directly (those live in
// IntegrationSetting instead), just somewhere safer than a local text
// file. Admin-only, like every other stored secret in this app.
model ApiKeyVaultEntry {
  id             String   @id @default(cuid())
  label          String
  valueEncrypted String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("api_key_vault_entries")
}

// Automation run history shown on the Dashboard's Automations section.
// "make" rows come from polling the Make API; "zapier" rows arrive via a
// webhook step added to each Zap (there's no usable "list my recent Zap
// runs" API for a personal Zapier account).
model AutomationRun {
  id         String   @id @default(cuid())
  source     String // "make" | "zapier"
  externalId String? // Make execution id / Zapier-provided id
  name       String? // scenario/zap name
  status     String // "success" | "error"
  message    String? @db.Text
  occurredAt DateTime
  raw        Json?

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([source, occurredAt])
  @@map("automation_runs")
}

// Daily per-platform-per-language social media metrics. Andrew posts in
// both English and French on every platform via separate Buffer
// accounts/channels (LinkedIn's follower count still comes from a Make.com
// scenario — see /api/webhooks/social-analytics), so each row is one
// platform + one language + one day, upserted so a re-run of the same
// day's sync updates the existing row instead of piling up duplicates.
// "raw" carries every metric a source actually returned (postCount,
// reactions, comments, reach, impressions, etc. — these vary a lot by
// platform), not just the three promoted columns below.
model SocialAnalyticsSnapshot {
  id         String   @id @default(cuid())
  platform   String // "facebook" | "instagram" | "linkedin" | "youtube" | "tiktok" | "x"
  language   String   @default("EN") // "EN" | "FR"
  dateKey    String // "YYYY-MM-DD", America/Montreal
  followers  Int?
  engagement Int? // likes + comments + shares over the platform's reporting window
  views      Int? // post/video views or impressions, when the platform reports it
  raw        Json?
  capturedAt DateTime @default(now())

  @@unique([platform, language, dateKey])
  @@index([platform, language, capturedAt])
  @@map("social_analytics_snapshots")
}

model SyncLog {
  id             String    @id @default(cuid())
  provider       String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String // "success" | "error" | "running"
  contactsSynced Int       @default(0)
  tagsSynced     Int       @default(0)
  errorMessage   String?   @db.Text

  @@map("sync_logs")
}
