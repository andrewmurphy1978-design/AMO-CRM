// Prisma schema for Andrew Murphy Online CRM
// Docs: https://pris.ly/d/prisma-schema

// Prisma runs over a driver instance we construct in code (node-postgres
// locally, the same driver pointed at Cloudflare's Hyperdrive binding in
// production) instead of connecting from a URL itself — required because
// Cloudflare Workers can't open its own raw database connections. See
// src/lib/prisma.ts.
// engineType "client" is Prisma's engine-less, pure-JS/WASM query compiler
// — the only engine type compatible with the `adapter` option (see
// src/lib/prisma.ts), which is what lets this run without a native binary
// on Cloudflare Workers.
generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Auth / Users
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MEMBER
}

enum Language {
  EN
  FR
}

enum TimeFormat {
  HOUR24
  HOUR12
}

model User {
  id                         String     @id @default(cuid())
  name                       String
  email                      String     @unique
  passwordHash               String
  role                       UserRole   @default(MEMBER)
  phone                      String?
  whatsapp                   String?
  country                    String     @default("CA")
  language                   Language   @default(EN)
  timeFormat                 TimeFormat @default(HOUR24)
  // Free-text rules appended to the Email page's Claude classification
  // prompt for this user's own inbox — e.g. "always treat emails from
  // my accountant as Needs a reply". Never required; screening works
  // fine with the built-in categories alone when this is empty.
  emailScreeningInstructions String?    @db.Text
  createdAt                  DateTime   @default(now())
  updatedAt                  DateTime   @updatedAt

  ownedProjects   Project[]           @relation("ProjectOwner")
  ownedContacts   Contact[]           @relation("ContactOwner")
  assignedTasks   Task[]              @relation("TaskAssignee")
  projectTeams    ProjectTeamMember[]
  activityEntries ActivityLogEntry[]
  interactions    Interaction[]
  googleAccount   GoogleAccount?
  ionosMailbox    IonosMailboxAccount?
  sentEmailRecords SentEmailRecord[]

  @@map("users")
}

// One personal Google connection per CRM user (Gmail + Calendar,
// read-only) — unlike IntegrationSetting below, this is never shared
// across the team, so it's its own model keyed to User rather than a
// provider-keyed singleton row.
model GoogleAccount {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email           String?
  tokensEncrypted String   @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("google_accounts")
}

// The IONOS-hosted mailbox one CRM user reads over IMAP and sends from
// over SMTP — the CRM's own mail client for an address like
// andrew@andrewmurphy.online, which has no OAuth flow of its own. Same
// shape as GoogleAccount above: one row per user, every secret inside one
// encrypted JSON blob (host/port/security x2, username, password) rather
// than a column per field.
model IonosMailboxAccount {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  address              String // the mailbox itself — also the address every reply to it is sent from
  displayName          String?
  credentialsEncrypted String    @db.Text // encrypted JSON: { imapHost, imapPort, imapSecurity, smtpHost, smtpPort, smtpSecurity, username, password }
  sentMailbox          String? // IMAP folder a sent copy is APPENDed to — discovered via LIST, editable in Settings
  lastCheckedAt        DateTime?
  lastError            String?   @db.Text // last IMAP/SMTP failure text, shown in Settings — protocol errors are otherwise invisible
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("ionos_mailbox_accounts")
}

// A message sent from the IONOS mailbox via SMTP — Gmail's own "Sent —
// awaiting reply" section is derived live from Gmail's Sent folder/thread
// data (see getSentAwaitingReplies in src/lib/google.ts), but IONOS has no
// equivalent API to query on demand, so each send is recorded here
// instead and reconciled against the mailbox's own recent inbox messages
// (matching In-Reply-To/References against messageId) on every refresh.
model SentEmailRecord {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messageId String  @unique // this sent message's own Message-ID header — what a reply's In-Reply-To/References is matched against
  to       String
  toEmail  String
  subject  String
  sentAt   DateTime @default(now())
  status   String   @default("awaiting") // "awaiting" | "completed" — same two states as Gmail's own SentEmailSummary.status

  @@index([userId])
  @@map("sent_email_records")
}

// ---------------------------------------------------------------------------
// Contacts / Clients (System.IO contact model)
// ---------------------------------------------------------------------------

// Lifecycle stage within our own pipeline (separate from systeme.io tags,
// which are synced verbatim into ContactTag below).
enum ContactStage {
  LEAD
  PROSPECT
  CLIENT
  PAST_CLIENT
  UNSUBSCRIBED
  // Not part of the sales pipeline — a personal/family contact pulled in
  // from Google Contacts with no systeme.io relationship. Never pushed to
  // systeme.io (that only happens for a contact that already has a
  // systemeIoId — see the save action in actions/contacts.ts).
  PERSONAL
}

model Contact {
  id String @id @default(cuid())

  // --- Core systeme.io fields ---
  // systeme.io's own numeric contact id, used as the sync key. Null for
  // contacts created directly in the CRM that have not been pushed/matched
  // to systeme.io yet.
  systemeIoId           Int?      @unique
  // Nullable — a personal contact imported from Google Contacts (see
  // google-contacts.ts) commonly has only a phone number, no email.
  // Postgres allows multiple NULLs under a unique constraint, so this
  // stays unique without conflicting for every email-less contact.
  email                 String?   @unique
  locale                String? // e.g. "en", "fr"
  systemeIoRegisteredAt DateTime? // registered_at from systeme.io
  // The Google People API resourceName (e.g. "people/c123...") this
  // contact was imported from or matched to — lets a re-import recognize
  // a contact it already created/linked instead of duplicating it.
  googleContactId       String?   @unique

  // --- Fields only Google Contacts (not systeme.io) ever populates ---
  // Stored as Google returns it: "YYYY-MM-DD", or "--MM-DD" when Google
  // has no year (a real, common case for a personal contact) — kept as
  // text rather than three separate int columns since nothing in the app
  // does date arithmetic on it yet, just displays it.
  birthday  String?
  nickname  String?
  // From the Google contact's primary organization's job title — distinct
  // from `company` above (that's the organization's name).
  jobTitle  String?
  // Google's own hosted photo URL — never re-hosted/downloaded, just
  // linked to directly.
  avatarUrl String?

  // --- Common systeme.io custom fields promoted to real columns for
  // fast search/sort. Any other custom field systeme.io returns is stored
  // in ContactFieldValue below so nothing is ever dropped. ---
  firstName String?
  lastName  String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  company   String?
  website   String?

  // --- Our own CRM-level fields (not from systeme.io) ---
  // Legal structure (e.g. "LLC", "Inc.") and business category — free text
  // backed by a suggestion list on the form, not a rigid enum, since these
  // vary a lot by country.
  companyType String?
  // Where the company is legally registered — separate from the contact's
  // mailing address/country above (a company can be incorporated somewhere
  // other than where its owner lives or does business).
  jurisdictionCountry String?
  jurisdictionRegion  String?
  industry            String?
  // Only the core fields above (phone/address/city/state/zip/country) are
  // pushed back to systeme.io on save — everything below is CRM-only
  // enrichment with no systeme.io equivalent.
  phone2      String?
  email2      String?
  // Unlimited additional phones/emails beyond the first two, added via the
  // "+" button on the Contact form — order in the array is display order.
  extraPhones String[] @default([])
  extraEmails String[] @default([])
  // IANA zone id (e.g. "America/Toronto"), explicitly chosen on the Contact
  // form — takes precedence over the country/state-derived guess in
  // getTimezoneForCountryState when set.
  timeZone    String?

  billingAddress           String?
  billingCity              String?
  billingState             String?
  billingZip               String?
  billingCountry           String?
  billingContactName       String?
  billingEmail             String?
  billingPhone             String?
  // When true, invoice payment reminders for this contact go out
  // automatically on schedule; when false, they're drafted for manual
  // review/send instead — set per-contact rather than as one global choice.
  autoSendInvoiceReminders Boolean @default(false)
  // e.g. "USD", "CAD" — ISO 4217 code, not the display label with symbol.
  preferredCurrency        String?
  paymentTerms             String? // e.g. "Net 30 days", "Immediately"
  paymentSchedule          String? // e.g. "50% / 40% / 10%"
  // Percentage (e.g. 10 for 10%), not a fraction.
  defaultDiscount          Float?

  // --- Tech stack info for done-for-you web/funnel/email/store services ---
  websiteDomain          String?
  websiteHostingProvider String?
  websiteDesignApp       String?
  funnelsDomain          String?
  funnelsHostingProvider String?
  funnelsDesignApp       String?
  emailDomain            String?
  emailHostingProvider   String?
  emailMarketingApp      String?
  storeDomain            String?
  storeHostingProvider   String?
  storeDesignApp         String?

  stage   ContactStage @default(LEAD)
  notes   String?      @db.Text
  ownerId String?
  owner   User?        @relation("ContactOwner", fields: [ownerId], references: [id])

  source       String? // e.g. "systeme.io", "manual", "clickfunnels"
  lastSyncedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags                 ContactTag[]
  fieldValues          ContactFieldValue[]
  projects             Project[]
  activity             ActivityLogEntry[]
  interactions         Interaction[]
  subscriptions        Subscription[]
  courseEnrollments    CourseEnrollment[]
  communityMemberships CommunityMembership[]
  emailLinks           EmailLink[]
  calendarEventLinks   CalendarEventLink[]
  bookings             Booking[]
  socialLinks          ContactSocialLink[]
  extraAddresses       ContactAddress[]
  messagingAccounts    ContactMessagingAccount[]
  voipAccounts         ContactVoipAccount[]
  techStackItems       ContactTechStackItem[]

  @@index([stage])
  @@index([lastName, firstName])
  @@map("contacts")
}

// Additional addresses beyond the main one, added via the Contact form's
// "+" button — same pattern as extraEmails/extraPhones, but an address
// needs several fields so it's a related row rather than a plain string.
// Replaces the old single otherAddress/otherCity/... columns.
model ContactAddress {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  address   String?
  city      String?
  state     String?
  zip       String?
  country   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("contact_addresses")
}

// Messaging apps beyond WhatsApp (which keeps its own dedicated phone
// field) — Telegram, Discord, Signal, etc. Each row is an app + the
// contact's handle/ID on it, added via the Contact form's "+" button.
model ContactMessagingAccount {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  app       String
  handle    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("contact_messaging_accounts")
}

// Preferred video/voice calling apps — Zoom, Google Meet, Teams, Skype,
// FaceTime, etc. — distinct from the instant-messaging apps above (a
// contact can prefer WhatsApp for chat but Zoom for calls). Each row is an
// app + the contact's ID/link/handle on it, added via the Contact form's
// "+" button; more than one is allowed.
model ContactVoipAccount {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  app       String
  handle    String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("contact_voip_accounts")
}

// Extra tech-stack rows beyond the fixed Website/Funnels/Email/Store ones
// — e.g. a booking app or a membership site — where the row's own label is
// free text instead of one of those four fixed names.
model ContactTechStackItem {
  id              String   @id @default(cuid())
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  label           String
  domain          String?
  hostingProvider String?
  app             String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([contactId])
  @@map("contact_tech_stack_items")
}

// Unlimited social profile/page links per contact, added via the Contact
// form's "+" button — e.g. a personal Facebook profile and a separate
// business Facebook page both fit as two rows with the same platform.
model ContactSocialLink {
  id        String   @id @default(cuid())
  contactId String
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  platform  String
  url       String
  createdAt DateTime @default(now())

  @@index([contactId])
  @@map("contact_social_links")
}

// --- Additional systeme.io data (subscriptions, courses, communities) ------
// systeme.io's public API doesn't document exact response field names for
// these resource categories the way it does for Contacts/Tags, so each
// record keeps the full raw payload (`raw`) alongside a few defensively
// extracted common fields — if the extracted fields turn out wrong for this
// account's actual data, the raw JSON is still there to fix them from.

model Subscription {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  status     String?
  planName   String?
  amount     Float?
  currency   String?
  startedAt  DateTime?
  canceledAt DateTime?
  raw        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("subscriptions")
}

model CourseEnrollment {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  courseName String?
  status     String?
  enrolledAt DateTime?
  raw        Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("course_enrollments")
}

model CommunityMembership {
  id          String   @id @default(cuid())
  systemeIoId Int      @unique
  contactId   String?
  contact     Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  communityName String?
  status        String?
  joinedAt      DateTime?
  raw           Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@map("community_memberships")
}

// Account-level marketing data from systeme.io — not tied to a single
// contact, so these live on their own "Marketing" page rather than the
// Contact detail page (unlike Subscription/CourseEnrollment/
// CommunityMembership above, which are per-contact).
model EmailCampaign {
  id          String @id @default(cuid())
  systemeIoId Int    @unique

  name           String?
  subject        String?
  status         String?
  sentAt         DateTime?
  recipientCount Int?
  openCount      Int?
  clickCount     Int?
  raw            Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_campaigns")
}

model AutomationWorkflow {
  id          String @id @default(cuid())
  systemeIoId Int    @unique

  name        String?
  status      String?
  triggerType String?
  raw         Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automation_workflows")
}

// systeme.io Booking Calendar bookings. The API's Booking resource carries
// only a bare contactName string for one-to-one bookings (never an id, and
// nothing at all for group bookings) — contactId below is filled in by the
// sync as a best-effort match against existing contacts by full name, not
// something systeme.io itself provides, so it's null whenever that match
// is missing or ambiguous (multiple contacts sharing the same name).
model Booking {
  id          String @id @default(cuid())
  systemeIoId Int    @unique

  eventName       String?
  eventType       String?
  eventDuration   Int?
  maxParticipants Int?
  bookedSlots     Int?
  contactName     String?
  status          String?
  paymentStatus   String?
  scheduledFor    DateTime?
  bookedAt        DateTime?
  raw             Json

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  calendarEventLinks CalendarEventLink[]

  @@index([contactId])
  @@map("bookings")
}

// Tag definitions, mirroring systeme.io tags (each has a systeme.io id/name).
model Tag {
  id          String  @id @default(cuid())
  systemeIoId Int?    @unique
  name        String  @unique
  color       String? // for UI badges

  contacts ContactTag[]

  createdAt DateTime @default(now())

  @@map("tags")
}

// Explicit join table (rather than an implicit m2m) so we can record when
// a tag was applied.
model ContactTag {
  contactId String
  tagId     String
  appliedAt DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

// Definition of every custom field systeme.io knows about (fetched from
// GET /api/contact_fields), so we can label raw slugs in the UI.
model CustomFieldDefinition {
  id        String   @id @default(cuid())
  slug      String   @unique
  label     String
  type      String? // text, number, date, etc. as reported by systeme.io
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  values ContactFieldValue[]

  @@map("custom_field_definitions")
}

// Catch-all storage for every systeme.io custom field value on a contact,
// including ones we haven't promoted to a dedicated column. This guarantees
// "all System.IO fields" are preserved even as systeme.io accounts add new
// custom fields over time.
model ContactFieldValue {
  id        String  @id @default(cuid())
  contactId String
  fieldSlug String
  value     String? @db.Text

  contact    Contact                @relation(fields: [contactId], references: [id], onDelete: Cascade)
  definition CustomFieldDefinition? @relation(fields: [fieldSlug], references: [slug])

  updatedAt DateTime @updatedAt

  @@unique([contactId, fieldSlug])
  @@map("contact_field_values")
}

// ---------------------------------------------------------------------------
// Projects & Tasks
// ---------------------------------------------------------------------------

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

// Based on Andrew's own service lines — drives no logic yet, just lets
// Projects be filtered/reported on by the kind of work.
enum ProjectType {
  WEBSITE
  FUNNEL
  APP
  SOCIAL_MEDIA
  CONSULTING
  OTHER
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  type        ProjectType   @default(OTHER)

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  ownerId String?
  owner   User?   @relation("ProjectOwner", fields: [ownerId], references: [id])

  startDate DateTime?
  dueDate   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tasks              Task[]
  phases             ProjectPhase[]
  teamMembers        ProjectTeamMember[]
  activity           ActivityLogEntry[]
  interactions       Interaction[]
  proposals          Proposal[]
  invoices           Invoice[]
  emailLinks         EmailLink[]
  calendarEventLinks CalendarEventLink[]

  @@index([status])
  @@index([contactId])
  @@map("projects")
}

// Team members working on a project, beyond its single owner — e.g. a
// designer and a copywriter both helping deliver the same website build.
model ProjectTeamMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt   DateTime @default(now())

  @@unique([projectId, userId])
  @@map("project_team_members")
}

// Sub-projects/steps within a Project — a lightweight grouping that existing
// Tasks opt into (via Task.phaseId) rather than a separate work-item type of
// their own. Edited through its own dialog (like a mini Project): its own
// status/type/team/dates/description, defaulting the team to the parent
// Project's own team members on creation.
model ProjectPhase {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  order     Int           @default(0)
  status    ProjectStatus @default(PLANNING)
  phaseType String?
  // Plain array of User ids rather than a join table — a phase's team is a
  // simple, non-relational snapshot (no addedAt/unique-constraint needs),
  // same pattern as Contact.extraPhones/extraEmails.
  teamMemberIds String[]  @default([])
  startDate     DateTime?
  dueDate       DateTime?
  description   String?   @db.Text
  createdAt     DateTime  @default(now())

  tasks Task[]

  @@index([projectId])
  @@map("project_phases")
}

enum ProposalStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
}

// Client-facing proposals. Always tied to a Project (which is itself tied to
// a Contact), so a proposal shows up both under its project and — via the
// project's contact — on that contact's page. No separate contactId: the
// project is the single source of truth for who it's for.
model Proposal {
  id        String         @id @default(cuid())
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  status    ProposalStatus @default(DRAFT)
  // Legacy flat total from the original quick-add flow — still written
  // there for a proposal with no line items. Once line items exist,
  // subtotal/taxAmount/totalAmount below are authoritative and this is
  // just kept in sync with totalAmount for anything still reading it.
  amount    Float?
  currency  String         @default("CAD")
  notes     String?        @db.Text

  // AI-assisted (or hand-written) opening paragraph shown above the line
  // items on the proposal itself.
  coverLetter String? @db.Text

  subtotal    Float @default(0)
  gstAmount   Float @default(0)
  qstAmount   Float @default(0)
  hstAmount   Float @default(0)
  taxAmount   Float @default(0) // gstAmount + qstAmount + hstAmount
  totalAmount Float @default(0) // subtotal + taxAmount

  sentAt      DateTime?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems       ProposalLineItem[]
  paymentSchedule ProposalPaymentScheduleItem[]
  invoices        Invoice[]

  @@index([projectId])
  @@map("proposals")
}

// A priced line item on a Proposal — either picked from the Service price
// list (in which case description/unitPrice start out copied from it, then
// can be freely edited) or entered from scratch.
model ProposalLineItem {
  id          String   @id @default(cuid())
  proposalId  String
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  description String
  quantity    Float    @default(1)
  unitPrice   Float
  order       Int      @default(0)

  @@index([proposalId])
  @@map("proposal_line_items")
}

// One row of a Proposal's payment schedule agreement — e.g. "50% deposit"
// / "50% on completion". Either a percentage of the total or a fixed
// amount, never both.
model ProposalPaymentScheduleItem {
  id         String    @id @default(cuid())
  proposalId String
  proposal   Proposal  @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  label      String
  percentage Float?
  amount     Float?
  dueDate    DateTime?
  order      Int       @default(0)

  @@index([proposalId])
  @@map("proposal_payment_schedule_items")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELED
}

// Client-facing invoices. Same "always via a Project" shape as Proposal —
// optionally generated from an already-accepted Proposal (copying its line
// items/tax breakdown as a starting point), but can also stand alone.
model Invoice {
  id         String        @id @default(cuid())
  projectId  String
  project    Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  proposalId String?
  proposal   Proposal?     @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  number     String?
  status     InvoiceStatus @default(DRAFT)
  // Legacy flat total — see the comment on Proposal.amount above; same
  // fallback relationship with subtotal/taxAmount/totalAmount below.
  amount     Float
  currency   String        @default("CAD")
  notes      String?       @db.Text

  subtotal    Float @default(0)
  gstAmount   Float @default(0)
  qstAmount   Float @default(0)
  hstAmount   Float @default(0)
  taxAmount   Float @default(0)
  totalAmount Float @default(0)

  dueDate DateTime?
  sentAt  DateTime?
  paidAt  DateTime?

  // Reminder tracking for the sent->paid lifecycle. Andrew's Gmail isn't
  // wired for sending mail from the CRM (only reading it), so a "reminder"
  // is a drafted email surfaced on the invoice for Andrew to review and
  // send himself — see src/lib/invoice-reminders.ts for why, and Contact.
  // autoSendInvoiceReminders for the per-client choice of how prominently
  // it's flagged.
  lastReminderAt DateTime?
  reminderCount  Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems InvoiceLineItem[]

  @@index([projectId])
  @@index([proposalId])
  @@map("invoices")
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float   @default(1)
  unitPrice   Float
  order       Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_line_items")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  phaseId String?
  phase   ProjectPhase? @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  assigneeId String?
  assignee   User?   @relation("TaskAssignee", fields: [assigneeId], references: [id])

  // "dueDate" predates the standalone Task feature and is kept as the
  // column name to avoid a rename migration — the Task UI presents it as
  // "End date" alongside the newer startDate.
  startDate   DateTime?
  dueDate     DateTime?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  emailLinks         EmailLink[]
  calendarEventLinks CalendarEventLink[]

  @@index([projectId])
  @@index([status])
  @@index([phaseId])
  @@map("tasks")
}

// Lightweight activity trail shown on contact/project detail pages.
model ActivityLogEntry {
  id      String @id @default(cuid())
  message String

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([projectId])
  @@map("activity_log_entries")
}

// Ties a Gmail thread to a client/project/task in this CRM. Gmail itself
// stays the source of truth for the message content — this is just a
// pointer keyed off the thread id (one CRM link per thread), so the Email
// page can show "linked to X" and the client/project/task page can show
// its related emails.
model EmailLink {
  id            String @id @default(cuid())
  gmailThreadId String @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  affiliateProgramId String?
  affiliateProgram   AffiliateProgram? @relation(fields: [affiliateProgramId], references: [id], onDelete: Cascade)

  // A snapshot taken at link time (subject/sender/date/Gmail url), not a
  // live reference — Gmail threads aren't otherwise queryable from here
  // without knowing which team member's account owns them (EmailLink has
  // no userId), so this is what lets a Contact's "Linked emails" card show
  // something readable without a live Gmail call on every page view.
  subject     String?
  fromLabel   String?
  messageDate DateTime?
  gmailLink   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@index([affiliateProgramId])
  @@map("email_links")
}

// One row per program on the "AI Tools" / "Training Programs" / "Business
// Opportunities" tabs of the "AMO Affiliate Link Tracker" Google Sheet
// (https://docs.google.com/spreadsheets/d/1dJ9sZz6fHNvwK7I_nKH72Ai1VWt1x_mUh_XQ6g7YWkg) —
// those three tabs share an identical 12-column schema. Synced periodically
// (see src/lib/affiliate-sheet.ts) via the sheet's public CSV export, so
// this needs no Google OAuth of its own — just the sheet being link-viewable.
// (tab, name) is the natural key from the sheet, used to upsert on each sync
// without disturbing the row's own id (which EmailLink links against).
enum AffiliateProgramTab {
  AI_TOOLS
  TRAINING_PROGRAMS
  BUSINESS_OPPORTUNITIES
}

model AffiliateProgram {
  id   String              @id @default(cuid())
  tab  AffiliateProgramTab
  name String // "Tool / Program"

  type            String? // one of AFFILIATE_TYPE_OPTIONS[tab] (src/lib/affiliate-status.ts) — displayed to the user as "Category"
  iconUrl         String? // small colored logo/icon shown beside the program name
  shortioCreated  Boolean @default(false) // "Short.io Created?"
  brandedLink     String? // "go.andrewmurphy.online Link"
  destinationLink String? // "Real Destination Link"
  affiliateStatus String? // one of the 8 fixed values in AFFILIATE_STATUS_VALUES (src/lib/affiliate-status.ts)
  statusDetails   String? @db.Text // free-text nuance moved out of affiliateStatus once it became a fixed set
  frenchSlug      String? // "French go.andrewmurphy.online Slug"
  frenchLink      String? // "French Affiliate/Fallback Link"
  followUpNeeded  Boolean @default(false) // "Follow-up Needed?"
  notes           String? @db.Text // "Notes"
  accountPlan     String? // "Account / Plan / Trial End"

  // Where/how to apply, and whether the program exposes its own API for
  // pulling stats (separate from the Short.io key in IntegrationSetting,
  // which only manages the branded short link, not this program's own data).
  applyUrl        String? // page to sign up for the affiliate program
  applyPlatform   String? // "PartnerStack" | "Impact" | "Direct" | freeform
  followUpDate    DateTime? @db.Date
  hasApi          Boolean   @default(false)
  apiKeyEncrypted String?   @db.Text

  // Short.io's own link id + click stats, kept separately for the English
  // (brandedLink) and French (frenchSlug) short links so each can be
  // resynced/updated independently.
  shortioLinkId        String?
  shortioLinkIdFr      String?
  shortioClicks        Int?
  shortioClicksFr      Int?
  shortioStats         Json?
  shortioStatsFr       Json?
  shortioStatsSyncedAt DateTime?

  emailLinks EmailLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tab, name])
  @@map("affiliate_programs")
}

enum EmailCategory {
  NEEDS_REPLY
  NEEDS_ATTENTION
  CAN_WAIT
  LOW_PRIORITY
}

// A message's importance rarely changes once received, so this is a
// permanent cache keyed by Gmail's own message id — classified once (via
// Claude), never reclassified, so revisiting the Email page doesn't
// re-spend an API call on messages it's already seen.
model EmailClassification {
  id             String        @id @default(cuid())
  gmailMessageId String        @unique
  category       EmailCategory
  classifiedAt   DateTime      @default(now())

  @@map("email_classifications")
}

// Marks a message as opened in the CRM (independent of Gmail's own
// read/unread flag — we don't have Gmail write scope, and don't need it;
// this is purely how the Email page decides what to keep showing).
// Once set, the email drops out of its category group into a "Recently
// read" bucket for 7 days (in case it still needs linking), then is
// archived out of view entirely — sooner if it gets linked before that.
model EmailReadState {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  readAt         DateTime @default(now())

  @@map("email_read_states")
}

// The Personal page's last-fetched family emails/events, one row per user
// (only Andrew's account currently qualifies — see isPersonalSectionUser).
// Same reasoning as EmailInboxCache: reopening the page reads this instead
// of re-running a live Gmail search + per-message fetch on every visit.
model PersonalInboxCache {
  id        String   @id @default(cuid())
  userId    String   @unique
  emails    Json
  events    Json
  fetchedAt DateTime @default(now())

  @@map("personal_inbox_cache")
}

// Manually marked "done" from the Email page's green-check action — kept
// separate from EmailClassification (the AI category) since completion is
// a user action, not something Claude decides. Unscoped by user, matching
// EmailReadState: message ids are unique per Gmail account and this app's
// few team accounts never collide in practice.
model EmailCompletion {
  id             String   @id @default(cuid())
  gmailMessageId String   @unique
  completedAt    DateTime @default(now())

  @@map("email_completions")
}

// The Email page's last-fetched inbox + recent sent-awaiting-reply list,
// one row per user. Reopening the page reads this instead of hitting
// Gmail (and re-spending Claude credits) on every visit — only pressing
// Refresh re-fetches and re-classifies (classification itself stays
// cache-aware via EmailClassification, so a refresh only ever costs a
// Claude call for genuinely new messages).
model EmailInboxCache {
  id                String   @id @default(cuid())
  userId            String   @unique
  emails            Json
  sentAwaitingReply Json?
  fetchedAt         DateTime @default(now())

  // The IONOS mailbox's own recent-messages snapshot, refreshed and
  // cached independently of the Gmail fields above (see
  // refreshEmailInboxCache's comment) — nullable so a user with no IONOS
  // mailbox connected, or an IMAP fetch that failed, never blanks out an
  // otherwise-good Gmail snapshot.
  ionosEmails    Json?
  ionosFetchedAt DateTime?

  @@map("email_inbox_cache")
}

// The roster behind the "Personal" section — a page visible only to
// Andrew, gathering emails and calendar events for family members (and
// himself) rather than the business. Fixed roster (Haley, Lukas, Diane,
// Me), but each one's watched addresses are data, editable from Andrew's
// own Settings card, not code.
model PersonalWatchPerson {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  emails PersonalWatchEmail[]

  @@map("personal_watch_people")
}

model PersonalWatchEmail {
  id       String              @id @default(cuid())
  personId String
  person   PersonalWatchPerson @relation(fields: [personId], references: [id], onDelete: Cascade)
  email    String

  @@unique([personId, email])
  @@map("personal_watch_emails")
}

// Same idea as EmailLink, but for a Google Calendar event (keyed off its
// event id) — links an appointment to a client, project, task, and/or a
// systeme.io booking.
model CalendarEventLink {
  id            String @id @default(cuid())
  googleEventId String @unique

  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactId])
  @@index([projectId])
  @@index([taskId])
  @@index([bookingId])
  @@map("calendar_event_links")
}

// A logged call, email, meeting, or note against a client and/or a project —
// distinct from ActivityLogEntry (which is an auto-generated system trail).
// This is user-authored history: "I called this client on this date and
// discussed X." Always tied to a contact; projectId is set when logged from
// a project's page, so the entry shows on both that project and its client.
enum InteractionType {
  CALL
  EMAIL
  MEETING
  NOTE
}

model Interaction {
  id      String          @id @default(cuid())
  type    InteractionType
  subject String?
  notes   String          @db.Text

  occurredAt DateTime @default(now())

  contactId String
  contact   Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  loggedById String?
  loggedBy   User?   @relation(fields: [loggedById], references: [id])

  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([projectId])
  @@map("interactions")
}

// ---------------------------------------------------------------------------
// Integrations
// ---------------------------------------------------------------------------

model IntegrationSetting {
  id              String    @id @default(cuid())
  provider        String    @unique // "systeme_io" | "make"
  apiKeyEncrypted String?
  lastSyncedAt    DateTime?
  lastSyncStatus  String?
  lastSyncError   String?   @db.Text
  autoSyncEnabled Boolean   @default(false)
  autoSyncTime    String    @default("03:00") // "HH:MM", America/Montreal time
  // Provider-specific extra config that doesn't need its own columns/table —
  // e.g. Make's zone + teamId.
  metadata        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("integration_settings")
}

// A general-purpose encrypted key/value vault — for API keys that don't
// power a specific feature the app calls directly (those live in
// IntegrationSetting instead), just somewhere safer than a local text
// file. Admin-only, like every other stored secret in this app.
model ApiKeyVaultEntry {
  id             String   @id @default(cuid())
  label          String
  valueEncrypted String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("api_key_vault_entries")
}

// Automation run history shown on the Dashboard's Automations section.
// "make" rows come from polling the Make API; "zapier" rows arrive via a
// webhook step added to each Zap (there's no usable "list my recent Zap
// runs" API for a personal Zapier account).
model AutomationRun {
  id         String   @id @default(cuid())
  source     String // "make" | "zapier"
  externalId String? // Make execution id / Zapier-provided id
  name       String? // scenario/zap name
  status     String // "success" | "error"
  message    String?  @db.Text
  occurredAt DateTime
  raw        Json?

  createdAt DateTime @default(now())

  @@unique([source, externalId])
  @@index([source, occurredAt])
  @@map("automation_runs")
}

// Daily per-platform-per-language social media metrics. Andrew posts in
// both English and French on every platform via separate Buffer
// accounts/channels (LinkedIn's follower count still comes from a Make.com
// scenario — see /api/webhooks/social-analytics), so each row is one
// platform + one language + one day, upserted so a re-run of the same
// day's sync updates the existing row instead of piling up duplicates.
// "raw" carries every metric a source actually returned (postCount,
// reactions, comments, reach, impressions, etc. — these vary a lot by
// platform), not just the three promoted columns below.
model SocialAnalyticsSnapshot {
  id         String   @id @default(cuid())
  platform   String // "facebook" | "instagram" | "linkedin" | "youtube" | "tiktok" | "x"
  language   String   @default("EN") // "EN" | "FR"
  dateKey    String // "YYYY-MM-DD", America/Montreal
  followers  Int?
  engagement Int? // likes + comments + shares over the platform's reporting window
  views      Int? // post/video views or impressions, when the platform reports it
  raw        Json?
  capturedAt DateTime @default(now())

  @@unique([platform, language, dateKey])
  @@index([platform, language, capturedAt])
  @@map("social_analytics_snapshots")
}

model SyncLog {
  id             String    @id @default(cuid())
  provider       String
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?
  status         String // "success" | "error" | "running"
  contactsSynced Int       @default(0)
  tagsSynced     Int       @default(0)
  errorMessage   String?   @db.Text

  @@map("sync_logs")
}

// The catalog of services Andrew sells, picked from when building a
// Proposal's line items — not client-facing on its own, managed from
// Settings.
model ServicePriceListItem {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  unitPrice   Float
  currency    String   @default("CAD")
  // Free text, e.g. "flat", "hour", "month" — shown next to the price, not
  // used in any calculation.
  unit        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("service_price_list_items")
}

// Single-row cache (always id "singleton") of CAD->{USD,EUR,GBP} exchange
// rates, refreshed from a live rate API when stale — see
// src/lib/exchange-rates.ts. Every Proposal/Invoice total is computed in
// its own currency and converted through this cache, never a hardcoded
// rate.
model ExchangeRateCache {
  id        String   @id @default("singleton")
  base      String   @default("CAD")
  rates     Json // e.g. {"USD": 0.73, "EUR": 0.68, "GBP": 0.58}
  fetchedAt DateTime @default(now())

  @@map("exchange_rate_cache")
}

// Single-row table (always id "singleton") for billing-wide settings that
// apply to every Proposal/Invoice rather than one Contact — currently just
// the Canadian-tax gate: Andrew doesn't charge GST/QST/HST until his
// revenue crosses the $30,000 registration threshold, so this stays off
// until he flips it.
model BillingSettings {
  id                String   @id @default("singleton")
  chargeCanadianTax Boolean  @default(false)
  gstNumber         String?
  qstNumber         String?
  updatedAt         DateTime @updatedAt

  @@map("billing_settings")
}
